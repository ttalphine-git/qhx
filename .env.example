# DigitalOcean Production Environment Variables
# Copy this to .env on the DigitalOcean server and fill in with actual values

# Database Configuration (DigitalOcean Managed PostgreSQL)
DB_URL=jdbc:postgresql://dev-tarik-postgresql-do-user-31900988-0.e.db.ondigitalocean.com:25061/qhx-pool?ssl=require&sslmode=require
DB_USER=doadmin
DB_PASSWORD=your-do-database-password-here

# For services using SPRING_DATASOURCE_* format
SPRING_DATASOURCE_URL=jdbc:postgresql://dev-tarik-postgresql-do-user-31900988-0.e.db.ondigitalocean.com:25061/qhx-pool?ssl=require&sslmode=require
SPRING_DATASOURCE_USERNAME=doadmin
SPRING_DATASOURCE_PASSWORD=your-do-database-password-here
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT Secret (change to a secure 256-bit secret in production)
JWT_SECRET=your-256-bit-secret-key-in-production

# Admin Passwords (change these in production!)
ADMIN_PASSWORD=your-secure-admin-password
SUPER_ADMIN_PASSWORD=your-secure-superadmin-password

# Server Port Configuration
SERVER_PORT=8081

# Optional: Set DO_API_TOKEN if not already in system environment
# DO_API_TOKEN=your-digitalocean-api-token
