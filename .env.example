# DigitalOcean Production Environment Variables
# Copy this to .env on the DigitalOcean server and fill in with actual values

# Database Configuration
# For the bundled PostgreSQL container, leave these as-is.
# For DigitalOcean Managed PostgreSQL, create one database per service or set each URL to
# the appropriate managed database/schema.
AUTH_DB_URL=jdbc:postgresql://postgres:5432/halalcms_auth
APPLICATION_DB_URL=jdbc:postgresql://postgres:5432/halalcms_applications
INSPECTION_DB_URL=jdbc:postgresql://postgres:5432/halalcms_inspections
CERTIFICATE_DB_URL=jdbc:postgresql://postgres:5432/halalcms_certificates
COMPANY_DB_URL=jdbc:postgresql://postgres:5432/halalcms_companies
DB_USER=doadmin
DB_PASSWORD=your-do-database-password-here

SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT Secret (change to a secure 256-bit secret in production)
JWT_SECRET=your-256-bit-secret-key-in-production

# Admin Passwords (change these in production!)
ADMIN_PASSWORD=your-secure-admin-password
SUPER_ADMIN_PASSWORD=your-secure-superadmin-password
TEST_CUSTOMER_PASSWORD=test123
BELLWBTRST_CUSTOMER_PASSWORD=bellwbtrst

# Server Port Configuration
SERVER_PORT=8081

# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-mail-app-password

# DigitalOcean Spaces
DO_SPACES_KEY=your-spaces-key
DO_SPACES_SECRET=your-spaces-secret
DO_SPACES_BUCKET=your-spaces-bucket
DO_SPACES_REGION=nyc3
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com

# Optional: Set DO_API_TOKEN if not already in system environment
# DO_API_TOKEN=your-digitalocean-api-token
