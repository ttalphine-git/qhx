# ═══════════════════════════════════════════════════════════════
# HalalCMS Backend Environment Configuration
# ═══════════════════════════════════════════════════════════════

# DATABASE CONFIGURATION
DB_URL=jdbc:postgresql://localhost:5432/halalcms_inspections
DB_USER=halalcms
DB_PASSWORD=halalcms

# SMTP EMAIL CONFIGURATION
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password

# JWT CONFIGURATION (Generate a strong 256-bit secret)
JWT_SECRET=your-256-bit-secret-key-here-generate-strong-key

# APPLICATION CONFIGURATION
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8084

# LOG LEVEL
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_HALALCMS=DEBUG

# ═══════════════════════════════════════════════════════════════
# NOTES:
#
# 1. To generate a strong JWT secret, use:
#    openssl rand -hex 32
#
# 2. For Gmail SMTP:
#    - Enable 2-Factor Authentication
#    - Generate App Password: https://myaccount.google.com/apppasswords
#    - Use the 16-character password here
#
# 3. Database should already exist with migrations applied via Flyway
#
# 4. Change DB_PASSWORD and MAIL_PASSWORD before deploying to production
# ═══════════════════════════════════════════════════════════════
